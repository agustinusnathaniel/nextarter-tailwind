{
  "name": "nextarter-tailwind",
  "version": "0.1.0",
  "private": true,
  "author": "agustinusnathaniel",
  "scripts": {
    "biome:ci": "biome ci",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "build:turbo": "pnpm turbo run build",
    "check:turbo": "pnpm turbo ultracite:check type:check",
    "dev": "next dev",
    "prepare": "husky",
    "push-release": "git push --follow-tags origin main",
    "release": "cross-env HUSKY=0 commit-and-tag-version",
    "start": "next start",
    "turbo": "pnpm dlx turbo@2.6.1",
    "type:check": "tsc --noEmit",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "commit-and-tag-version": "^13.3.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.2",
      "onFail": "download"
    }
  }
}
